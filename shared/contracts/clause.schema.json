{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clause",
  "type": "object",
  "required": ["id", "document_id", "text"],
  "properties": {
    "id": { "type": "string" },
    "document_id": { "type": "string" },
    "text": { "type": "string" },
    "category": { "enum": ["OBLIGATION", "RIGHT", "PENALTY", "TERMINATION", "PAYMENT_TERM", "OTHER"] },
    "sentiment": { "enum": ["FAVORABLE", "UNFAVORABLE", "NEUTRAL"] },
    "rule_id": { "type": ["string", "null"], "description": "Id of the rule that matched this clause" },
    "score": {
      "type": "object",
      "required": ["auto"],
      "properties": {
        "auto": { "type": "number", "description": "Original automatic score. Never overwritten." },
        "lawyer_override": { "type": ["number", "null"], "description": "Optional score set by a lawyer" }
      }
    },
    "explanation": { "type": "string" }
  }
}
