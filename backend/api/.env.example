# Copy to .env and fill in. Never commit .env.
# No database? Skip this file: without a DATABASE_URL the backend starts in OFFLINE DEMO mode (in-memory data, public demo accounts).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
CORE_URL=http://localhost:8001
# Set to false only for a local Postgres without TLS
DB_SSL=true
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
